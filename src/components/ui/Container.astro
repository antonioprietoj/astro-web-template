---
interface Props {
  as?: 'div' | 'section' | 'article' | 'aside' | 'main';
  narrow?: boolean;
  class?: string;
}

const { as: Tag = 'div', narrow = false, class: className } = Astro.props;
---

<Tag class:list={['container', narrow && 'container--narrow', className]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-px);
  }

  .container--narrow {
    max-width: 800px;
  }

  @media (min-width: 640px) {
    .container {
      padding-inline: var(--space-8);
    }
  }
</style>
