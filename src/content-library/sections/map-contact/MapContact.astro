---
import Container from '@/components/ui/Container.astro';
import { site } from '@/data/site';
import { tel, mailto, whatsappUrl } from '@/utils/seo';

interface Props {
  mapEmbedUrl?: string;  // Google Maps embed URL
  title?: string;
}

const {
  mapEmbedUrl,
  title = 'Cómo llegar',
} = Astro.props;

// Default embed from address if no custom URL provided
const defaultEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(
  `${site.address.street}, ${site.address.zip} ${site.address.city}`
)}&output=embed`;

const embedUrl = mapEmbedUrl ?? defaultEmbed;
---

<section class="section section--white map-contact">
  <Container>
    <div class="map-contact__grid">
      <!-- Map -->
      <div class="map-contact__map">
        <h2 class="map-contact__title">{title}</h2>
        <iframe
          src={embedUrl}
          class="map-contact__iframe"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          title={`Mapa de ${site.name}`}
          width="600"
          height="400"
        ></iframe>
      </div>

      <!-- Info -->
      <aside class="map-contact__info">
        <h2 class="map-contact__title">Dónde estamos</h2>

        <ul class="map-info" role="list">
          <li class="map-info__item">
            <span class="map-info__icon" aria-hidden="true">📍</span>
            <div>
              <p class="map-info__label">Dirección</p>
              <a href={site.address.mapsUrl} target="_blank" rel="noopener noreferrer" class="map-info__value">
                {site.address.street}<br />
                {site.address.zip} {site.address.city}
              </a>
            </div>
          </li>
          <li class="map-info__item">
            <span class="map-info__icon" aria-hidden="true">📞</span>
            <div>
              <p class="map-info__label">Teléfono</p>
              <a href={tel()} class="map-info__value">{site.phoneFormatted}</a>
            </div>
          </li>
          <li class="map-info__item">
            <span class="map-info__icon" aria-hidden="true">✉️</span>
            <div>
              <p class="map-info__label">Email</p>
              <a href={mailto()} class="map-info__value">{site.email}</a>
            </div>
          </li>
          <li class="map-info__item">
            <span class="map-info__icon" aria-hidden="true">🕐</span>
            <div>
              <p class="map-info__label">Horario</p>
              <p class="map-info__value">{site.schedule.weekdays}</p>
              <p class="map-info__value">{site.schedule.saturday}</p>
            </div>
          </li>
        </ul>

        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="map-contact__wa"
        >
          💬 Escríbenos por WhatsApp
        </a>
      </aside>
    </div>
  </Container>
</section>

<style>
  .map-contact__grid {
    display: grid;
    gap: var(--space-10);
  }

  @media (min-width: 768px) {
    .map-contact__grid { grid-template-columns: 1fr 1fr; align-items: start; }
  }

  .map-contact__title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-6);
  }

  .map-contact__iframe {
    width: 100%;
    height: 360px;
    border: 0;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }

  .map-info { display: flex; flex-direction: column; gap: var(--space-5); margin-bottom: var(--space-8); }
  .map-info__item { display: flex; align-items: flex-start; gap: var(--space-3); }
  .map-info__icon { font-size: 1.25rem; flex-shrink: 0; margin-top: 2px; }
  .map-info__label { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-neutral-light); font-weight: var(--font-weight-semibold); margin-bottom: 2px; }
  .map-info__value { font-size: var(--text-sm); color: var(--color-neutral); text-decoration: none; display: block; }
  .map-info__value:hover { color: var(--color-primary); }

  .map-contact__wa {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: #25d366;
    color: #fff;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: background var(--transition-fast);
  }

  .map-contact__wa:hover { background: #128c4a; color: #fff; }
</style>
