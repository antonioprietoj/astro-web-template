---
import Container from '@/components/ui/Container.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';

export interface GalleryItem {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  items: GalleryItem[];
  columns?: 2 | 3 | 4;
}

const {
  title    = 'Galería de trabajos',
  subtitle = 'Algunos de nuestros proyectos recientes.',
  items,
  columns  = 3,
} = Astro.props;
---

<section class="section section--alt gallery">
  <Container>
    <SectionTitle {title} {subtitle} />

    <ul class:list={['gallery__grid', `gallery__grid--${columns}`]} role="list">
      {items.map(item => (
        <li class="gallery__item">
          <figure>
            <img
              src={item.src}
              alt={item.alt}
              loading="lazy"
              width="400"
              height="300"
              class="gallery__img"
            />
            {item.caption && <figcaption class="gallery__caption">{item.caption}</figcaption>}
          </figure>
        </li>
      ))}
    </ul>
  </Container>
</section>

<style>
  .gallery__grid {
    display: grid;
    gap: var(--space-4);
  }

  .gallery__grid--2 { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .gallery__grid--3 { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .gallery__grid--4 { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }

  .gallery__item figure {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    background: var(--color-surface);
  }

  .gallery__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .gallery__item:hover .gallery__img {
    transform: scale(1.04);
  }

  .gallery__caption {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-neutral-light);
  }
</style>
